# Copy to .env.local. Never commit a real API key.

# Azure OpenAI / Foundry image-editing deployment. The backend is the only
# process that reads these values; they are never returned to the browser.
CONTACTS_IMAGE_ENDPOINT=https://your-resource.openai.azure.com
CONTACTS_IMAGE_API_KEY=replace-with-your-local-key
CONTACTS_IMAGE_DEPLOYMENT=gpt-image-2
CONTACTS_IMAGE_API_VERSION=2025-04-01-preview

# Generated photos must remain within the API's 2 MiB contact-photo limit.
CONTACTS_IMAGE_SIZE=1024x1024
CONTACTS_IMAGE_QUALITY=medium
CONTACTS_IMAGE_OUTPUT_FORMAT=jpeg
CONTACTS_IMAGE_TIMEOUT_SECONDS=240
